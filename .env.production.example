# Copy to .env.production on the VPS and fill in real values.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Do not commit the filled-in .env.production file.

# --- Supabase Cloud project (NOT the local Docker Supabase used in dev) ---
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Public app URLs (real domains, https) ---
NEXT_PUBLIC_STOREFRONT_URL=https://shop.example.com
NEXT_PUBLIC_BROCHURE_URL=https://www.example.com

# --- Domains Caddy will request TLS certificates for ---
# Must already point at this VPS's IP (A record) before first `docker compose up`,
# or Let's Encrypt validation will fail.
STOREFRONT_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com
BROCHURE_DOMAIN=www.example.com

# --- Email ---
# packages/email/src/send-email.ts currently connects to whatever
# MAILPIT_HOST/MAILPIT_PORT point to (named after the local dev-only Mailpit
# inbox, but it's just a plain SMTP connection under the hood). For
# production this must point at a real SMTP relay/transactional email
# provider — there is no Mailpit in production. docker-compose.prod.yml
# maps these through to MAILPIT_HOST/MAILPIT_PORT/MAILPIT_USER/MAILPIT_PASS
# for you.
#
# Using Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend,
# SMTP_PASS=<your Resend API key>. EMAIL_FROM must be an address on a
# domain you've verified in the Resend dashboard (Domains tab) — Resend
# rejects sends from an unverified domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=orders@example.com
INQUIRY_RECIPIENT_EMAIL=orders@example.com

# --- Unused by current code (packages/config/src/env.ts never reads it),
# kept for parity with config/env.shared.local; safe to leave as-is or drop ---
NEXTAUTH_SECRET=
